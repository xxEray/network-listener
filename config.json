{
  "machine_id": "",
  "collector_host": "",
  "collector_port": 48123,
  "shared_secret": "",
  "poll_seconds": 3,
  "state_file": "state.json",
  "local_log": "alerts.jsonl",
  "local_log_max_mb": 16,
  "local_log_backups": 5,
