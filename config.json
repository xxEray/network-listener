    "wpad",
    "*.msedge.net",
    "*.footprintdns.com",
    "*.azurefd.net",
    "go.microsoft.com",
    "www.microsoft.com",
    "edge.microsoft.com",
    "ieonline.microsoft.com",
    "checkappexec.microsoft.com",
    "oneocsp.microsoft.com",
    "crl.microsoft.com",
    "ocsp.digicert.com"
  ],
  "allowed_domains": [
    "*.seuoj.best"
  ],
  "tcp_watch": {
    "enabled": false,
    "interval_seconds": 30,
    "known_ip_minutes": 30
  }
